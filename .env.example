# --- Подключение к PostgreSQL ---
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=file_manager

# Администратор БД
DB_ADMIN_USER=fm_admin
DB_ADMIN_PASSWORD=223

# Пользователь приложения с минимальными правами
DB_APP_USER=fm_app
DB_APP_PASSWORD=2323

# --- Файловая система ---
SANDBOX_DIR=./sandbox
MAX_FILE_SIZE=10485760

# --- Ограничения ZIP ---
ZIP_MAX_ENTRIES=1000
ZIP_MAX_TOTAL_SIZE=104857600

# --- Аутентификация ---
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_MINUTES=5
