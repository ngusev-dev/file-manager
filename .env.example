# --- Подключение к PostgreSQL ---
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=file_manager

# Администратор БД: используется только скриптом npm run db:init и docker-compose
DB_ADMIN_USER=fm_admin
DB_ADMIN_PASSWORD=223

# Пользователь приложения с минимальными правами (только EXECUTE на функции)
DB_APP_USER=fm_app
DB_APP_PASSWORD=2323

# --- Файловая система ---
# Корень песочницы: у каждого пользователя свой подкаталог внутри
SANDBOX_DIR=./sandbox
MAX_FILE_SIZE=10485760

# --- Ограничения ZIP (защита от zip bomb) ---
ZIP_MAX_ENTRIES=1000
ZIP_MAX_TOTAL_SIZE=104857600
ZIP_MAX_RATIO=100

# --- Аутентификация ---
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_MINUTES=15
